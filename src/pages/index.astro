---
import Layout from "@layouts/Layout.astro";

import Section from "@layouts/Section.astro";
import Text from "@components/Text.astro";
import ExperienceLayout from "@layouts/ExperienceLayout.astro";
import WelcomeSection from "@layouts/WelcomeSection.astro";
import { ProjectsSection } from "@layouts/ProjectsSection.tsx";

import info from "../data/info-es.json";

const {
  page_title,
  page_description,
  greeting, 
  title, 
  about_me_title,
  about_me_description,
  experience_title,
  experience,
  personal_projects_title,
  personal_projects_description,
  projects
} = info;

---

<Layout lang="es" title={page_title} description={page_description}>
  <WelcomeSection greeting={greeting} title={title} />
  <Section title={about_me_title}>
    <Text class="md:text-base xl:w-10/12 xl:mx-auto xl:text-lg text-center">{about_me_description}</Text>
  </Section>
  <Section title={experience_title}>
    <ExperienceLayout experience={experience} />
  </Section>
  <Section title={personal_projects_title}>
    <Text class="text-sm mb-10 md:text-base xl:w-10/12 xl:mx-auto xl:text-lg text-center">
      {personal_projects_description}
    </Text>
    <ProjectsSection projects={projects} client:load />
  </Section>
</Layout>
