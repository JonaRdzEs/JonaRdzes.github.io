---
import IconLink from "@components/IconLink.astro";
import Github from "@components/icons/Github.astro";
import Email from "@components/icons/Email.astro";
import CVButton from "@components/CVButton.astro";
import AstronautImage from "@components/AstronautImage.astro";

const eml = "jonathan.rdzes@gmail.com";

interface Props {
  greeting: string,
  title: string,
}

const { greeting, title } = Astro.props;

---

<div class="relative flex flex-col-reverse sm:flex sm:justify-center sm:items-center sm:flex-row lg:w-10/12 mx-auto">
  <div>
    <div class="w-full pt-1">
      <h1 class="text-3xl text-celestial-white font-extrabold text-center sm:text-left md:text-4xl xl:text-6xl">
        {greeting} <br /> Jonathan Rodríguez
      </h1>
      <h2 class="text-center font-bold mt-2 text-electric-blue md:text-2xl lg:text-3xl sm:text-left">{title}</h2>
    </div>
    <div class="w-full flex justify-center items-center flex-wrap gap-4 mt-10 sm:justify-start">
      <IconLink href={`mailto:${eml}`} aria-label={`Enviar correro electrónico a ${eml} `} >
        <Email />
      </IconLink>
      <IconLink href="https://github.com/JonaRdzEs" aria-label="Visitar mi Github">
        <Github />
      </IconLink>
      <CVButton />
    </div>
  </div>
  <div class="flex justify-center items-center w-10/12 h-72 mx-auto sm:w-6/12 xl:w-5/12 sm:max-h-[350px] sm:ml-auto sm:mr-0 lg:max-h-none lg:min-h-[450px]" >
    <AstronautImage />
  </div>
</div>