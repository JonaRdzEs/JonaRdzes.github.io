---
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"a">;
const props = Astro.props;
---

<a
  {...props}
  href="/cv.pdf"
  download="Jonathan-Rodriguez-CV.pdf"
  class="bg-aurora-blue w-32 h-9 font-bold text-sm px-2 py-2 ease-in-out duration-300 hover:bg-darker-blue text-celestial-white flex justify-center items-center rounded-sm"
>
  Descargar CV
</a>
